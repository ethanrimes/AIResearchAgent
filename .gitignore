venvs/
agent-venv-311/
myagent-env/
.env

# Ignore write test files
**/entrypoint_write_test.txt

# Ignore all log files
**/*.logsandbox/writable/

# Ignore file types recursively in sandbox/writable and its subdirectories
sandbox/writable/**/*.txt
sandbox/writable/**/*.json
sandbox/writable/**/*.log
sandbox/writable/**/*.py
sandbox/writable/**/*.sh
sandbox/writable/**/*.yaml

# Ignore all subdirectories (their contents)
sandbox/writable/*/
# Ignore everything in sandbox/writeable
sandbox/writeable/
# Extra ignore for specific file types
sandbox/writeable/*.json
sandbox/writeable/*.txt
